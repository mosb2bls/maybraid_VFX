# Streaming route across a few hundred metres of Discovery from the origin.
# Hold / goto use the virtual pad, so vegetation and urbanization stream in
# the same way a player walking the route would.
#
# Warmup absorbs the first stream-in; the measure window is the loop with
# sprint, look-while-goto, and a few jumps.

{"cmd":"scenario","name":"biome-traverse-warmup","mark":"start"}
{"cmd":"console","line":"stats vsync"}
{"cmd":"console","line":"sky noon"}
{"cmd":"wait","secs":10}
{"cmd":"hold","move":[0,1],"secs":6}
{"cmd":"scenario","name":"biome-traverse-warmup","mark":"end"}

{"cmd":"scenario","name":"biome-traverse","mark":"start"}
{"cmd":"hold","move":[0,1],"buttons":["sprint"],"secs":8}
{"cmd":"hold","look":[0.4,0],"secs":1.2}
{"cmd":"press","button":"jump"}
{"cmd":"goto","xz":[180,0],"timeout":90,"radius":6,"sprint":true,"look":[0.18,0]}
{"cmd":"press","button":"jump"}
{"cmd":"goto","xz":[180,180],"timeout":90,"radius":6,"sprint":true,"look":[-0.16,0.08]}
{"cmd":"hold","look":[0,0.35],"secs":1.0}
{"cmd":"hold","look":[0,-0.25],"secs":0.8}
{"cmd":"goto","xz":[0,180],"timeout":90,"radius":6,"sprint":true}
{"cmd":"press","button":"jump"}
{"cmd":"goto","xz":[20,20],"timeout":90,"radius":6}
{"cmd":"wait","secs":4}
{"cmd":"scenario","name":"biome-traverse","mark":"end"}
{"cmd":"quit"}
