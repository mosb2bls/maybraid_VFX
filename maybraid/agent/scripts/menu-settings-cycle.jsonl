# Script API 6. Cycle every pause setting, Back to the pause root, Start
# closes pause. Run with --start-at and a one-character fixture roster.

{"cmd":"wait_for","flow":"world","pause":"playing","timeout":90}
{"cmd":"press","button":"start"}
{"cmd":"wait_for","screen":"in_game","timeout":10}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"confirm"}
{"cmd":"wait_for","screen":"settings","timeout":10}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"confirm"}
{"cmd":"wait","secs":0.3}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"dpad_right"}
{"cmd":"wait","secs":0.3}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"confirm"}
{"cmd":"wait","secs":0.3}
{"cmd":"press","button":"back"}
{"cmd":"wait_for","screen":"in_game","timeout":10}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"start"}
{"cmd":"wait_for","pause":"playing","screen":"none","timeout":5}
{"cmd":"expect","pause":"playing"}
{"cmd":"quit"}
