# Windowed Tanz playtest: enter Tanzer, fire starter Tanzes, GPU-readback shots.
# Paths are rewritten by the playtest launcher; defaults land in /tmp.
{"cmd":"start","xz":[0,0]}
{"cmd":"visual_style","style":"native"}
{"cmd":"console","line":"sky noon"}
{"cmd":"scenario","name":"tanz-warmup","mark":"start"}
{"cmd":"wait","secs":10}
{"cmd":"scenario","name":"tanz-warmup","mark":"end"}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/01-standard-idle.png"}
{"cmd":"wait","secs":1.5}
{"cmd":"tanz_mode","mode":"tanzer"}
{"cmd":"wait","secs":0.4}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/02-tanzer-idle.png"}
{"cmd":"wait","secs":0.4}
{"cmd":"scenario","name":"tanz-left-strafe","mark":"start"}
{"cmd":"tanz","id":"left_strafe"}
{"cmd":"wait","secs":0.14}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/03-left-strafe.png"}
{"cmd":"wait","secs":0.7}
{"cmd":"scenario","name":"tanz-left-strafe","mark":"end"}
{"cmd":"scenario","name":"tanz-right-strafe","mark":"start"}
{"cmd":"tanz","id":"right_strafe"}
{"cmd":"wait","secs":0.14}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/04-right-strafe.png"}
{"cmd":"wait","secs":0.7}
{"cmd":"scenario","name":"tanz-right-strafe","mark":"end"}
{"cmd":"scenario","name":"tanz-forward-dash","mark":"start"}
{"cmd":"tanz","id":"forward_dash"}
{"cmd":"wait","secs":0.14}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/05-forward-dash.png"}
{"cmd":"wait","secs":0.7}
{"cmd":"scenario","name":"tanz-forward-dash","mark":"end"}
{"cmd":"scenario","name":"tanz-healing-salute","mark":"start"}
{"cmd":"tanz","id":"healing_salute"}
{"cmd":"wait","secs":0.18}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/06-healing-salute.png"}
{"cmd":"wait","secs":1.0}
{"cmd":"scenario","name":"tanz-healing-salute","mark":"end"}
{"cmd":"tanz_mode","mode":"standard"}
{"cmd":"wait","secs":0.4}
{"cmd":"hold","buttons":["ads","bumper_fire"],"secs":0.5}
{"cmd":"wait","secs":0.3}
{"cmd":"scenario","name":"tanz-pad-dash","mark":"start"}
{"cmd":"hold","move":[0,1],"secs":0.35}
{"cmd":"wait","secs":0.12}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/07-pad-forward-dash.png"}
{"cmd":"wait","secs":0.6}
{"cmd":"scenario","name":"tanz-pad-dash","mark":"end"}
{"cmd":"hold","move":[-1,0],"secs":0.35}
{"cmd":"wait","secs":0.12}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/08-pad-left-strafe.png"}
{"cmd":"wait","secs":0.6}
{"cmd":"hold","move":[0,1],"buttons":["jump"],"secs":0.2}
{"cmd":"wait","secs":0.16}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/09-pad-healing-salute.png"}
{"cmd":"wait","secs":1.0}
{"cmd":"hold","look":[0.35,0.1],"secs":0.8}
{"cmd":"screenshot","path":"/tmp/maybraid-tanz-shots/10-tanzer-look.png"}
{"cmd":"wait","secs":1.5}
{"cmd":"tanz_mode","mode":"standard"}
{"cmd":"quit"}
