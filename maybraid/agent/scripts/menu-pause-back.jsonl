# Script API 6. World → Start (pause) → Settings → Back to pause root →
# Start unpauses. Run with --start-at and a one-character fixture roster.
# Covers the `back` alias on a pause sub-screen after #1265's shared modal stack.

{"cmd":"wait_for","flow":"world","pause":"playing","timeout":90}
{"cmd":"wait","secs":0.3}
{"cmd":"press","button":"start"}
{"cmd":"wait_for","screen":"in_game","pause":"menu","timeout":10}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait_for","screen":"in_game","focus_label":"Settings","timeout":3}
{"cmd":"press","button":"confirm"}
{"cmd":"wait_for","screen":"settings","timeout":10}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"back"}
{"cmd":"wait_for","screen":"in_game","pause":"menu","timeout":10}
{"cmd":"expect","screen":"in_game"}
{"cmd":"wait","secs":0.2}
{"cmd":"press","button":"start"}
{"cmd":"wait_for","pause":"playing","screen":"none","timeout":5}
{"cmd":"expect","pause":"playing"}
{"cmd":"quit"}
