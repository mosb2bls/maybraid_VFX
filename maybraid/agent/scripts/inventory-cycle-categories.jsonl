# Script API 7. World boot. D-pad selects Lubikans / skill maps / weapons;
# Y cycles the equipped queue inside the selected category and must not move
# the category. Run with --start-at and the one-character + cycling inventory
# fixture (bullpup → reltor → grenade, fireball → dumbwave, Self).

{"cmd":"wait_for","flow":"world","pause":"playing","timeout":90}
{"cmd":"wait","secs":0.5}
{"cmd":"wait_for","cycle_category":"weapons","weapon":"bullpup","skill_map":"fireball","lubikan":"self","timeout":15}
{"cmd":"press","button":"y"}
{"cmd":"wait_for","cycle_category":"weapons","weapon":"reltor","timeout":3}
{"cmd":"wait","secs":0.5}
{"cmd":"expect","skill_map":"fireball","lubikan":"self"}
{"cmd":"press","button":"y"}
{"cmd":"wait_for","cycle_category":"weapons","weapon":"grenade","timeout":3}
{"cmd":"wait","secs":0.5}
{"cmd":"press","button":"y"}
{"cmd":"wait_for","cycle_category":"weapons","weapon":"bullpup","timeout":3}
{"cmd":"wait","secs":0.5}
{"cmd":"press","button":"dpad_down"}
{"cmd":"wait_for","cycle_category":"skill_maps","timeout":3}
{"cmd":"expect","weapon":"bullpup","lubikan":"self"}
{"cmd":"press","button":"y"}
{"cmd":"wait_for","cycle_category":"skill_maps","skill_map":"dumbwave","timeout":3}
{"cmd":"expect","weapon":"bullpup"}
{"cmd":"press","button":"dpad_left"}
{"cmd":"wait_for","cycle_category":"lubikans","timeout":3}
{"cmd":"expect","weapon":"bullpup","skill_map":"dumbwave"}
{"cmd":"press","button":"y"}
{"cmd":"wait","secs":0.4}
{"cmd":"expect","cycle_category":"lubikans","lubikan":"self","weapon":"bullpup","skill_map":"dumbwave"}
{"cmd":"press","button":"dpad_right"}
{"cmd":"wait_for","cycle_category":"weapons","timeout":3}
{"cmd":"expect","weapon":"bullpup","skill_map":"dumbwave","lubikan":"self"}
{"cmd":"quit"}
